{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@sis/shared-types": ["packages/shared-types/src/index.ts"],
      "@sis/shared-types/*": ["packages/shared-types/src/*"],
      "@sis/shared-validation": ["packages/shared-validation/src/index.ts"],
      "@sis/shared-validation/*": ["packages/shared-validation/src/*"],
      "@sis/api-contracts": ["packages/api-contracts/src/index.ts"],
      "@sis/api-contracts/*": ["packages/api-contracts/src/*"],
      "@sis/design-tokens": ["packages/design-tokens/src/index.ts"],
      "@sis/design-tokens/*": ["packages/design-tokens/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
