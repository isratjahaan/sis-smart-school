# ==============================================================================
# SIS SMART SCHOOL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# Never commit actual secret keys (.env.local) to version control.
# Never expose SUPABASE_SERVICE_ROLE_KEY to frontend or mobile clients.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SERVER-SIDE ONLY: NEVER EXPOSE IN CLIENT BUNDLES OR MOBILE APPS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# PLATFORM & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development # development | staging | production
NEXT_PUBLIC_PLATFORM_DOMAIN=sissmartschool.com
NEXT_PUBLIC_PLATFORM_NAME="SIS Smart School"
NEXT_PUBLIC_DEFAULT_LOCALE=en # en | bn

# ------------------------------------------------------------------------------
# MOBILE APP REMOTE CONFIG & PUSH NOTIFICATIONS (FCM)
# ------------------------------------------------------------------------------
FCM_SERVER_KEY=your-firebase-cloud-messaging-server-key
FIREBASE_PROJECT_ID=sis-smart-school-firebase-project

# ------------------------------------------------------------------------------
# PAYMENT RECEIVER & GATEWAY CONFIGURATIONS (MANUAL / AUTOMATED)
# ------------------------------------------------------------------------------
# School Admins & Super Admins configure their account numbers via dashboard settings
DEFAULT_BKASH_MERCHANT_NUMBER=01700000000
DEFAULT_NAGAD_MERCHANT_NUMBER=01800000000
DEFAULT_ROCKET_MERCHANT_NUMBER=01900000000

# ------------------------------------------------------------------------------
# STORAGE BUCKET NAMES
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORAGE_BUCKET_PUBLIC=public-assets
STORAGE_BUCKET_DOCUMENTS=private-student-documents
STORAGE_BUCKET_ACADEMIC=private-academic-files
